// Edge Function: fcm-panic-alert
// Handles panic button alerts with <5s latency requirement
// Sends FCM to all muthawif/team-support in the grup

import { serve } from 'https://deno.land/std@0.168.0/http/server.ts'
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

interface PanicAlertPayload {
  rombongaId: string
  distressedLat: number
  distressedLng: number
  timestamp: string
}

// FCM Server Key from environment
const FCM_SERVER_KEY = Deno.env.get('FCM_SERVER_KEY') || ''

async function sendFCMNotification(token: string, payload: {
  title: string
  body: string
  data: Record<string, string>
}) {
  const response = await fetch('https://fcm.googleapis.com/fcm/send', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `key=${FCM_SERVER_KEY}`,
    },
    body: JSON.stringify({
      to: token,
      notification: {
        title: payload.title,
        body: payload.body,
        sound: 'critical',
        'interruption-level': 'critical',
      },
      data: payload.data,
      android: {
        priority: 'high',
        notification: {
          channel_id: 'panic_alerts',
          sound: 'critical',
          default_vibrate_timings: true,
        },
      },
      apns: {
        headers: {
          'apns-priority': '10',
          'apns-push-type': 'critical',
        },
        payload: {
          aps: {
            alert: {
              title: payload.title,
              body: payload.body,
            },
            sound: 'critical',
            'interruption-level': 'critical',
          },
        },
      },
    }),
  })
  return response.json()
}

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const authHeader = req.headers.get('Authorization')
    if (!authHeader) {
      return new Response(JSON.stringify({ error: 'Missing authorization' }), {
        status: 401,
        headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      })
    }

    const supabaseClient = createClient(
      Deno.env.get('SUPABASE_URL') ?? '',
      Deno.env.get('SUPABASE_ANON_KEY') ?? '',
      { global: { headers: { Authorization: authHeader } } }
    )

    // Get user from JWT
    const { data: { user }, error: authError } = await supabaseClient.auth.getUser()
    if (authError || !user) {
      return new Response(JSON.stringify({ error: 'Unauthorized' }), {
        status: 401,
        headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      })
    }

    const payload: PanicAlertPayload = await req.json()

    // Validate payload
    if (!payload.rombongaId || payload.distressedLat === undefined || payload.distressedLng === undefined) {
      return new Response(JSON.stringify({ error: 'Malformed payload' }), {
        status: 400,
        headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      })
    }

    // Check rate limit (1 per 5 min)
    const fiveMinutesAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString()
    const { data: recentAlerts } = await supabaseClient
      .from('panic_alerts')
      .select('id')
      .eq('jamaaah_id', user.id)
      .gte('timestamp', fiveMinutesAgo)
      .limit(1)

    if (recentAlerts && recentAlerts.length > 0) {
      return new Response(JSON.stringify({ error: 'Rate limit exceeded' }), {
        status: 429,
        headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      })
    }

    // Get user's profile for name
    const { data: profile } = await supabaseClient
      .from('profiles')
      .select('name')
      .eq('id', user.id)
      .single()

    // Insert panic alert
    const { data: panicAlert, error: insertError } = await supabaseClient
      .from('panic_alerts')
      .insert({
        jamaaah_id: user.id,
        grup_id: payload.rombongaId,
        latitude: payload.distressedLat,
        longitude: payload.distressedLng,
        timestamp: payload.timestamp || new Date().toISOString(),
        status: 'pending'
      })
      .select()
      .single()

    if (insertError) {
      console.error('Panic alert insert error:', insertError)
      return new Response(JSON.stringify({ error: 'Internal error' }), {
        status: 500,
        headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      })
    }

    // Get all muthawif/admin FCM tokens for the group members
    // First get all profiles in the same rombonga
    const { data: groupMembers } = await supabaseClient
      .from('profiles')
      .select('id, name, role')
      .eq('rombonga_id', payload.rombongaId)
      .in('role', ['muthawif', 'admin'])

    if (groupMembers && groupMembers.length > 0) {
      const memberIds = groupMembers.map(m => m.id)
      
      // Get their FCM tokens
      const { data: tokens } = await supabaseClient
        .from('fcm_tokens')
        .select('token, user_id')
        .in('user_id', memberIds)
        .eq('is_active', true)

      // Send FCM to each device
      const fcmPromises = tokens?.map(async (tokenRecord) => {
        try {
          await sendFCMNotification(tokenRecord.token, {
            title: '🚨 Emergency Alert',
            body: `${profile?.name || 'Jamaah'} needs help!`,
            data: {
              type: 'panic_alert',
              alert_id: panicAlert.id,
              jamaaah_id: user.id,
              latitude: payload.distressedLat.toString(),
              longitude: payload.distressedLng.toString(),
              timestamp: payload.timestamp || new Date().toISOString(),
            }
          })
        } catch (fcmError) {
          console.error('FCM send error:', fcmError)
        }
      }) || []

      await Promise.allSettled(fcmPromises)
    }

    return new Response(JSON.stringify({ 
      status: 'success', 
      messageId: panicAlert.id,
      notifiedCount: groupMembers?.length || 0
    }), {
      status: 200,
      headers: { ...corsHeaders, 'Content-Type': 'application/json' },
    })

  } catch (error) {
    console.error('Panic alert function error:', error)
    return new Response(JSON.stringify({ error: 'Internal error' }), {
      status: 500,
      headers: { ...corsHeaders, 'Content-Type': 'application/json' },
    })
  }
})
