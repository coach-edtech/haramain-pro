# =============================================================
# Haramain Pro — Environment Variables
# =============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to git — it is already in .gitignore
# =============================================================

# ---------- SUPABASE (REQUIRED) ----------
# Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-side only, never expose

# ---------- FIREBASE (for FCM push notifications) ----------
# Get from: Firebase Console > Project Settings > General > Your apps
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=haramain-pro
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_IOS_BUNDLE_ID=com.haramain.pro
FIREBASE_IOS_APP_ID=1:your-app-id:ios:your-app-id
FIREBASE_ANDROID_APP_ID=1:your-app-id:android:your-app-id
FCM_SERVER_KEY=your-fcm-server-key

# ---------- TWILIO (SMS fallback) ----------
# Get from: Twilio Console > Account > API Credentials
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+12345678901

# ---------- AI SERVICE (Virtual Muthawif) ----------
# Your AI API provider (OpenAI, Claude, MiniMax, etc.)
AI_API_KEY=your-ai-api-key
AI_API_ENDPOINT=https://api.your-ai-provider.com/v1/chat

# ---------- APP CONFIG ----------
# Set to 'true' for debug builds, 'false' for production
DEBUG=false

# ---------- EMERGENCY CONTACTS ----------
# Comma-separated phone numbers (Indonesian format, no spaces)
EMERGENCY_CONTACTS=+628123456789,+628987654321

# ---------- XENDIT PAYMENT (TIER23 - B2C Safety Pass) ----------
# Get from: Xendit Dashboard > Settings > API Keys
# Set in Supabase Edge Functions Secrets, NOT in Flutter .env
XENDIT_API_KEY=your-xendit-api-key-here
XENDIT_CALLBACK_SECRET=your-xendit-callback-secret-here

# =============================================================
# The following are used ONLY by Supabase Edge Functions
# (server-side). Set in Supabase Dashboard > Settings >
# Edge Functions > Secrets, NOT in the Flutter .env
# =============================================================

# Edge Function Security
PANIC_WEBHOOK_SECRET=your-panic-webhook-secret-here
